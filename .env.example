# =============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar este archivo a .env y completar los valores
# cp .env.example .env
# NUNCA commitear .env (solo .env.example)
# =============================================================

# Ambiente: development | staging | production
VITE_ENVIRONMENT=development

# Nivel de log: debug | info | error
VITE_LOG_LEVEL=debug

# URL base del API (incluye /api/v1)
# Local:      http://localhost:8080/api/v1
# Producción: https://innovatech-alb-516038279.us-east-1.elb.amazonaws.com/api/v1
VITE_API_URL=https://your-api-url.com/api/v1

# Timeout de requests en milisegundos
VITE_TIMEOUT=10000

# Número de reintentos en caso de error
VITE_RETRY_ATTEMPTS=3
